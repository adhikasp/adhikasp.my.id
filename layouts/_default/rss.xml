{{- /* Based on Hugo's internal RSS template (v0.169), two changes:
       1. feed entries use the front-matter description (or a short plain-text summary) instead of
          the rendered summary — notebook posts rendered themselves into 3.8 MB of feed XML;
       2. services.rss.limit in config.toml caps the item count. 2026-11-09 */ -}}
{{- $authorName := "" }}
{{- with site.Params.author }}
	{{- if reflect.IsMap . }}
		{{- with .name }}{{ $authorName = . }}{{ end }}
	{{- else }}
		{{- $authorName = . }}
	{{- end }}
{{- end }}

{{- $pctx := . }}
{{- if .IsHome }}{{ $pctx = .Site }}{{ end }}
{{- $pages := slice }}
{{- if or $.IsHome $.IsSection }}
	{{- $pages = $pctx.RegularPages }}
{{- else }}
	{{- $pages = $pctx.Pages }}
{{- end }}
{{- $limit := .Site.Config.Services.RSS.Limit }}
{{- if ge $limit 1 }}
	{{- $pages = $pages | first $limit }}
{{- end }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
	<channel>
		<title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{ . }} on {{ end }}{{ .Site.Title }}{{ end }}</title>
		<link>{{ .Permalink }}</link>
		<description>Recent content {{ if ne .Title .Site.Title }}{{ with .Title }}in {{ . }} {{ end }}{{ end }}on {{ .Site.Title }}</description>
		<generator>Hugo</generator>
		<language>{{ site.Language.Locale }}</language>
		{{- if $authorName }}
			<managingEditor>{{ $authorName }}</managingEditor>
		{{- end }}
		{{- if not .Date.IsZero }}
			<lastBuildDate>{{ (index $pages.ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
		{{- end }}
		{{- with .OutputFormats.Get "RSS" }}
			{{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
		{{- end }}
		{{- range $pages }}
			{{- $desc := "" }}
			{{- with .Description }}{{ $desc = . }}{{ else }}{{ $desc = .Summary | plainify | htmlUnescape | chomp }}{{ end }}
			{{- if gt (len $desc) 500 }}{{ $desc = printf "%s…" (substr $desc 0 500) }}{{ end }}
			<item>
				<title>{{ .Title }}</title>
				<link>{{ .Permalink }}</link>
				<pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
				{{- with $authorName }}<author>{{ . }}</author>{{ end }}
				<guid>{{ .Permalink }}</guid>
				<description>{{ $desc | transform.XMLEscape | safeHTML }}</description>
			</item>
		{{- end }}
	</channel>
</rss>
